{
  "$description": "Portfolio design tokens. Primitive -> semantic. Semantic tokens resolve per theme. Run `npm run tokens` to regenerate src/styles/tokens.css.",
  "primitive": {
    "color": {
      "gray-0": "#FFFFFF",
      "gray-50": "#F5F5F5",
      "gray-100": "#EDEDED",
      "gray-200": "#E5E5E5",
      "gray-400": "#C2C2C2",
      "gray-500": "#737373",
      "gray-700": "#3F3F3F",
      "gray-950": "#0A0A0A",
      "night-900": "#0D0E10",
      "night-800": "#16181B",
      "night-700": "#1E2024",
      "night-600": "#2A2D33",
      "night-400": "#8A8F97",
      "night-300": "#A7ABB2",
      "night-100": "#EDEDED",
      "signal-500": "#FF4F00",
      "signal-400": "#FF6A2B",
      "cloud-50": "#E8E9E6",
      "cloud-100": "#D3DDE1",
      "cloud-300": "#A9BFC9",
      "cloud-500": "#7C9DAE",
      "cloud-600": "#56788D",
      "cloud-650": "#4B6A7E",
      "cloud-700": "#3E5F74",
      "cloud-900": "#2B2F33",
      "surface-0": "#FFFFFF",
      "surface-50": "#FCFCFE",
      "surface-100": "#F7F8FD",
      "surface-200": "#EFF2FB",
      "surface-300": "#EBEEFA",
      "surface-400": "#D6DCF5",
      "surface-500": "#848EAE",
      "surface-600": "#5A6481",
      "surface-700": "#4A5268",
      "surface-800": "#383C48",
      "surface-900": "#22252F",
      "surface-950": "#181C26"
    },
    "font": {
      "sans": "'Inter', ui-sans-serif, system-ui, sans-serif"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "72px",
      "9": "96px",
      "10": "128px"
    },
    "radius": {
      "sm": "4px",
      "md": "12px",
      "lg": "20px",
      "pill": "999px"
    }
  },
  "semantic": {
    "light": {
      "color-bg": "{color.surface-0}",
      "color-surface": "{color.surface-0}",
      "color-surface-muted": "{color.surface-100}",
      "color-surface-strong": "{color.surface-300}",
      "color-text": "{color.surface-950}",
      "color-text-muted": "{color.surface-700}",
      "color-text-subtle": "{color.surface-600}",
      "color-border": "{color.surface-300}",
      "color-border-strong": "{color.surface-400}",
      "color-accent": "{color.surface-600}",
      "color-inverse-bg": "{color.surface-950}",
      "color-inverse-text": "{color.surface-0}",
      "color-heading": "{color.surface-950}",
      "color-heading-soft": "{color.surface-600}"
    },
    "dark": {
      "color-bg": "{color.night-900}",
      "color-surface": "{color.night-800}",
      "color-surface-muted": "{color.night-800}",
      "color-surface-strong": "{color.night-700}",
      "color-text": "{color.night-100}",
      "color-text-muted": "{color.night-300}",
      "color-text-subtle": "{color.night-400}",
      "color-border": "{color.night-600}",
      "color-border-strong": "{color.night-400}",
      "color-accent": "{color.signal-400}",
      "color-inverse-bg": "{color.night-100}",
      "color-inverse-text": "{color.night-900}",
      "color-heading": "{color.night-100}",
      "color-heading-soft": "{color.surface-500}"
    }
  }
}