{
  "$description": "Portfolio design tokens. Primitive -> semantic. Semantic tokens resolve per theme. Run `npm run tokens` to regenerate src/styles/tokens.css.",
  "primitive": {
    "color": {
      "gray-0": "#FFFFFF",
      "gray-50": "#F5F5F5",
      "gray-100": "#EDEDED",
      "gray-200": "#E5E5E5",
      "gray-400": "#C2C2C2",
      "gray-500": "#737373",
      "gray-700": "#3F3F3F",
      "gray-950": "#0A0A0A",
      "night-900": "#0D0E10",
      "night-800": "#16181B",
      "night-700": "#1E2024",
      "night-600": "#2A2D33",
      "night-400": "#8A8F97",
      "night-300": "#A7ABB2",
      "night-100": "#EDEDED",
      "signal-500": "#FF4F00",
      "signal-400": "#FF6A2B"
    },
    "font": {
      "sans": "'Inter', ui-sans-serif, system-ui, sans-serif"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "72px",
      "9": "96px",
      "10": "128px"
    },
    "radius": {
      "sm": "4px",
      "md": "12px",
      "lg": "20px",
      "pill": "999px"
    }
  },
  "semantic": {
    "light": {
      "color-bg": "{color.gray-0}",
      "color-surface": "{color.gray-0}",
      "color-surface-muted": "{color.gray-50}",
      "color-surface-strong": "{color.gray-100}",
      "color-text": "{color.gray-950}",
      "color-text-muted": "{color.gray-700}",
      "color-text-subtle": "{color.gray-500}",
      "color-border": "{color.gray-200}",
      "color-border-strong": "{color.gray-400}",
      "color-accent": "{color.signal-500}",
      "color-inverse-bg": "{color.gray-950}",
      "color-inverse-text": "{color.gray-0}"
    },
    "dark": {
      "color-bg": "{color.night-900}",
      "color-surface": "{color.night-800}",
      "color-surface-muted": "{color.night-800}",
      "color-surface-strong": "{color.night-700}",
      "color-text": "{color.night-100}",
      "color-text-muted": "{color.night-300}",
      "color-text-subtle": "{color.night-400}",
      "color-border": "{color.night-600}",
      "color-border-strong": "{color.night-400}",
      "color-accent": "{color.signal-400}",
      "color-inverse-bg": "{color.night-100}",
      "color-inverse-text": "{color.night-900}"
    }
  }
}