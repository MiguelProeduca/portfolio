{
  "$description": "Portfolio design tokens. Primitive -> semantic. Semantic tokens resolve per theme. Run `npm run tokens` to regenerate src/styles/tokens.css.",
  "primitive": {
    "color": {
      "bone-50": "#FFFFFF",
      "bone-100": "#F4F4F1",
      "bone-200": "#ECECE8",
      "bone-300": "#E8E8E3",
      "bone-400": "#D9D9D4",
      "bone-500": "#C9C9C3",
      "bone-600": "#B5B5AE",
      "ink-400": "#6E6E68",
      "ink-500": "#5C5C57",
      "ink-900": "#111110",
      "night-900": "#0D0E10",
      "night-800": "#121418",
      "night-700": "#1B1E23",
      "night-600": "#2A2D33",
      "night-400": "#8A8F97",
      "night-300": "#A7ABB2",
      "night-100": "#E7E5DF",
      "signal-500": "#FF4F00",
      "signal-400": "#FF6A2B"
    },
    "font": {
      "sans": "'Geist', ui-sans-serif, system-ui, sans-serif",
      "mono": "'Geist Mono', ui-monospace, monospace"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "72px",
      "9": "96px",
      "10": "128px"
    },
    "radius": {
      "sm": "4px",
      "pill": "999px"
    }
  },
  "semantic": {
    "light": {
      "color-bg": "{color.bone-100}",
      "color-surface": "{color.bone-50}",
      "color-surface-muted": "{color.bone-300}",
      "color-text": "{color.ink-900}",
      "color-text-muted": "{color.ink-500}",
      "color-text-subtle": "{color.ink-400}",
      "color-border": "{color.bone-400}",
      "color-border-strong": "{color.ink-900}",
      "color-border-control": "{color.bone-500}",
      "color-decor": "{color.bone-600}",
      "color-accent": "{color.signal-500}",
      "color-inverse-bg": "{color.ink-900}",
      "color-inverse-text": "{color.bone-100}"
    },
    "dark": {
      "color-bg": "{color.night-900}",
      "color-surface": "{color.night-800}",
      "color-surface-muted": "{color.night-700}",
      "color-text": "{color.night-100}",
      "color-text-muted": "{color.night-300}",
      "color-text-subtle": "{color.night-400}",
      "color-border": "{color.night-600}",
      "color-border-strong": "{color.night-100}",
      "color-border-control": "{color.night-600}",
      "color-decor": "{color.night-400}",
      "color-accent": "{color.signal-400}",
      "color-inverse-bg": "{color.night-100}",
      "color-inverse-text": "{color.night-900}"
    }
  }
}
