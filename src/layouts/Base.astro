---
import '../styles/global.css';
import { site } from '../site';
import { t, prefix, switchPath, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** home: the header floats over a full-screen hero passed in the "hero" slot */
  overlay?: boolean;
}
const { lang, overlay = false } = Astro.props;
const s = t[lang];
const title = Astro.props.title ?? s.siteTitle;
const description = Astro.props.description ?? s.description;
const path = Astro.url.pathname;
const home = `${prefix(lang)}/`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.site ? new URL(path, Astro.site) : null;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(switchPath(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchPath(path, 'en'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <div class:list={["header-wrap", { "header-wrap--overlay": overlay }]}>
      <header class="site-header">
        <a href={home} class="brand">{site.name}</a>
        <button class="theme-switch" type="button" aria-label={s.themeLabel} aria-pressed="false">
          <svg class="ts-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle class="ts-sun-core" cx="12" cy="12" r="4.6"/><path d="M12 2.6v2.3M12 19.1v2.3M2.6 12h2.3M19.1 12h2.3M5.4 5.4l1.6 1.6M17 17l1.6 1.6M5.4 18.6 7 17M17 7l1.6-1.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="ts-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.6A8 8 0 0 1 9.4 4a8 8 0 1 0 10.6 10.6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
        <div class="header-right">
          <nav aria-label="Main">
            <ul>
              {s.nav.map((item) => (
                <li><a href={`${home}#${item.hash}`}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="lang" role="group" aria-label={s.langLabel}>
            {langs.map((l) =>
              l === lang ? (
                <span aria-current="true">{l.toUpperCase()}</span>
              ) : (
                <a href={switchPath(path, l)} hreflang={l} lang={l}>{l.toUpperCase()}</a>
              ),
            )}
          </div>
        </div>
      </header>
    </div>
    <main id="main">
      <slot name="hero" />
      <div class="container">
        <slot />
      </div>
    </main>
    <div class="container">
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href={home}>{s.home}</a>
          {s.nav.map((item) => <a href={`${home}#${item.hash}`}>{item.label}</a>)}
        </nav>
        <div class="footer-right">
          {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
          <a href={`mailto:${site.email}`}>Email</a>
          <span class="subtle">© {year}</span>
        </div>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('.theme-switch');
        function sync() { btn.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark')); }
        sync();
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        function apply(next) {
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        }
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          if (reduce) return apply(next);
          // smooth crossfade of the whole page where supported
          if (document.startViewTransition) { document.startViewTransition(function () { apply(next); }); return; }
          // fallback: ease colours for a moment
          root.classList.add('theme-anim');
          apply(next);
          setTimeout(function () { root.classList.remove('theme-anim'); }, 700);
        });
      })();
    </script>
  </body>
</html>

<style>
  /* Full-width nav: name left, light/dark switch centred, links right */
  .header-wrap { padding: 0 clamp(20px, 2.6vw, 40px); }
  .header-wrap--overlay { position: absolute; top: 8px; left: 8px; right: 8px; z-index: 2; padding: 0 clamp(12px, 2.2vw, 32px); }
  .site-header {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: 8px 24px; padding: 20px 0;
  }
  .brand { justify-self: start; font-size: 16px; font-weight: 700; letter-spacing: -0.01em; }
  .header-right { justify-self: end; display: flex; align-items: center; gap: 4px 24px; }
  nav ul { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  nav li { display: flex; align-items: center; }
  nav li + li::before { content: ''; width: 1px; height: 14px; margin: 0 18px; background: currentColor; opacity: .55; }
  nav a { display: inline-block; padding: 12px 0; font-size: 15px; font-weight: 600; }
  .lang { display: flex; gap: 10px; font-size: 13px; font-weight: 600; }
  .lang > * { display: inline-block; padding: 12px 0; }
  .lang a { color: var(--color-text-subtle); }
  .lang a:hover { color: var(--color-text); }

  .theme-switch {
    display: inline-flex; align-items: center; gap: 14px;
    padding: 8px 10px; border: 0; border-radius: 999px; background: transparent;
    color: inherit; cursor: pointer;
  }
  .theme-switch svg { display: block; transition: color .2s ease, opacity .2s ease; }
  .ts-sun-core { fill: currentColor; stroke: currentColor; stroke-width: 1.6; }
  .ts-moon { fill: none; opacity: .4; }
  :global([data-theme="dark"]) .ts-sun { opacity: .4; }
  :global([data-theme="dark"]) .ts-sun-core { fill: none; }
  :global([data-theme="dark"]) .ts-moon { fill: currentColor; opacity: 1; }
  .theme-switch:hover svg { opacity: 1; }

  @media (max-width: 760px) {
    .site-header { grid-template-columns: 1fr auto; }
    .theme-switch { grid-column: 2; grid-row: 1; margin-right: -10px; }
    .header-right { grid-column: 1 / -1; justify-self: stretch; justify-content: space-between; }
    nav li + li::before { margin: 0 12px; }
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 120px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
  }
  .site-footer nav, .footer-right { display: flex; flex-wrap: wrap; gap: 4px 24px; align-items: center; }
  .site-footer a { padding: 8px 0; }
</style>
