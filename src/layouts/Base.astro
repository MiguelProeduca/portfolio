---
import '../styles/global.css';
import { site } from '../site';
import { t, prefix, switchPath, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** home: the header floats over a full-screen hero passed in the "hero" slot */
  overlay?: boolean;
  /** full-width layout with the home gutter (no overlay) */
  wide?: boolean;
}
const { lang, overlay = false } = Astro.props;
const wide = overlay || (Astro.props.wide ?? false);
const s = t[lang];
const title = Astro.props.title ?? s.siteTitle;
const description = Astro.props.description ?? s.description;
const path = Astro.url.pathname;
const home = `${prefix(lang)}/`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.site ? new URL(path, Astro.site) : null;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(switchPath(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchPath(path, 'en'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light" />
    <script is:inline>document.documentElement.setAttribute('data-theme', 'light');</script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <link rel="stylesheet" href="https://use.typekit.net/urj6tjc.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <div class:list={["header-wrap", { "header-wrap--overlay": overlay, "header-wrap--wide": wide }]}>
      <header class="site-header">
        <a href={home} class="brand" aria-label={site.name}><span class="brand-full" aria-hidden="true">{site.name}</span><span class="brand-short" aria-hidden="true">MA</span></a>
        <div class="header-right">
          <nav aria-label="Main">
            <ul>
              {s.nav.map((item) => (
                <li><a href={`${home}#${item.hash}`}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="lang" role="group" aria-label={s.langLabel}>
            {langs.map((l) =>
              l === lang ? (
                <span aria-current="true">{l.toUpperCase()}</span>
              ) : (
                <a href={switchPath(path, l)} hreflang={l} lang={l}>{l.toUpperCase()}</a>
              ),
            )}
          </div>
        </div>
      </header>
    </div>
    <main id="main">
      <slot name="hero" />
      <div class:list={["container", { "container--wide": wide }]}>
        <slot />
      </div>
    </main>
    <div class:list={["container", { "container--wide": wide }]}>
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href={home}>{s.home}</a>
          {s.nav.map((item) => <a href={`${home}#${item.hash}`}>{item.label}</a>)}
        </nav>
        <div class="footer-right">
          {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
          <a href={`mailto:${site.email}`}>Email</a>
          <span class="subtle">© {year}</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  /* Full-width nav: name left, light/dark switch centred, links right */
  .header-wrap { padding: 0 clamp(20px, 2.6vw, 40px); }
  .header-wrap--wide { padding: 0 var(--gutter); }
  .header-wrap--overlay { color: #181C26; }
  .header-wrap--overlay .lang a { color: #5A6481; }
  .header-wrap--overlay .lang a:hover { color: #181C26; }
  .header-wrap--overlay a:hover { color: #5A6481; }
  .header-wrap--overlay { position: absolute; top: 8px; left: 8px; right: 8px; z-index: 2; padding: 0 clamp(12px, 2.2vw, 32px); }
  /* home with motion: header stays, the name arrives into it, it turns solid past the hero */
  .header-wrap--overlay.is-home { position: fixed; top: 0; left: 0; right: 0; padding: 0 var(--gutter); transition: background-color .4s ease, box-shadow .4s ease; }
  .header-wrap--overlay.is-home .site-header { padding: 18px 0; }
  .header-wrap--overlay.is-home.is-solid { background: color-mix(in srgb, var(--color-bg) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 1px 0 var(--color-border); }
  .header-wrap--overlay.is-home .brand { opacity: 0; transition: opacity .2s ease; }
  .header-wrap--overlay.is-home.show-brand .brand { opacity: 1; }
  .site-header {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;
    gap: 8px 24px; padding: 20px 0;
  }
  .brand { justify-self: start; font-size: 16px; font-weight: 700; letter-spacing: -0.01em; }
  .brand-short { display: none; }
  @media (max-width: 760px) { .brand-full { display: none; } .brand-short { display: inline; } }
  .header-right { justify-self: end; display: flex; align-items: center; gap: 4px 24px; }
  nav ul { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  nav li { display: flex; align-items: center; }
  nav li + li::before { content: ''; width: 1px; height: 14px; margin: 0 18px; background: currentColor; opacity: .55; }
  nav a { display: inline-block; padding: 12px 0; font-size: 15px; font-weight: 600; }
  .lang { display: flex; gap: 10px; font-size: 13px; font-weight: 600; }
  .lang > * { display: inline-block; padding: 12px 0; }
  .lang a { color: var(--color-text-subtle); }
  .lang a:hover { color: var(--color-text); }


  @media (max-width: 760px) {
    .header-right { gap: 4px 16px; }
    nav li + li::before { margin: 0 12px; }
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 120px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
  }
  .site-footer nav, .footer-right { display: flex; flex-wrap: wrap; gap: 4px 24px; align-items: center; }
  .site-footer a { padding: 8px 0; }
</style>
