---
import '../styles/global.css';
import { site } from '../site';
import { t, prefix, switchPath, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  backLink?: boolean;
}
const { lang, backLink = false } = Astro.props;
const s = t[lang];
const title = Astro.props.title ?? s.siteTitle;
const description = Astro.props.description ?? s.description;
const path = Astro.url.pathname;
const home = `${prefix(lang)}/`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.site ? new URL(path, Astro.site) : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(switchPath(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchPath(path, 'en'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <div class="container">
      <header class="site-header">
        <a href={home} class="brand">{site.name}</a>
        <div class="header-right">
          {backLink ? (
            <a href={`${home}#work`} class="label"><span aria-hidden="true">←</span> {s.allWork}</a>
          ) : (
            <nav aria-label="Main">
              <ul>
                {s.nav.map((item) => (
                  <li>
                    <a href={`${home}#${item.hash}`} class="label">
                      <span class="label--subtle">{item.n}</span> {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <div class="lang label" role="group" aria-label={s.langLabel}>
            {langs.map((l) =>
              l === lang ? (
                <span class="lang-current" aria-current="true">{l.toUpperCase()}</span>
              ) : (
                <a href={switchPath(path, l)} hreflang={l} lang={l}>{l.toUpperCase()}</a>
              ),
            )}
          </div>
        </div>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer id="contact" class="site-footer">
        <span class="label label--muted">{s.availability}</span>
        <div class="footer-links">
          <a class="label" href={`mailto:${site.email}`}>{site.email}</a>
          {site.linkedin && <a class="label" href={site.linkedin}>LinkedIn</a>}
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--p-space-4);
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .brand { font-size: 15px; font-weight: 500; letter-spacing: -0.01em; }
  .header-right { display: flex; flex-wrap: wrap; align-items: center; gap: var(--p-space-2) 28px; }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--p-space-2) 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a { display: inline-block; padding: 12px 0; }
  .lang {
    display: flex;
    align-items: center;
    gap: 2px;
    padding-left: 20px;
    border-left: 1px solid var(--color-border);
  }
  .lang a, .lang-current { display: inline-block; padding: 12px 6px; }
  .lang a { color: var(--color-text-subtle); }
  .lang a:hover { color: var(--color-text); }
  .lang-current { color: var(--color-text); }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--p-space-4);
    padding: 28px 0 40px;
    border-top: 1px solid var(--color-border);
  }
  .footer-links { display: flex; gap: var(--p-space-5); flex-wrap: wrap; }
</style>
