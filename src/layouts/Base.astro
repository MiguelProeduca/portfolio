---
import '../styles/global.css';
import { site } from '../site';
import { t, prefix, switchPath, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** home: the header floats over a full-screen hero passed in the "hero" slot */
  overlay?: boolean;
}
const { lang, overlay = false } = Astro.props;
const s = t[lang];
const title = Astro.props.title ?? s.siteTitle;
const description = Astro.props.description ?? s.description;
const path = Astro.url.pathname;
const home = `${prefix(lang)}/`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.site ? new URL(path, Astro.site) : null;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(switchPath(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchPath(path, 'en'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>document.documentElement.setAttribute('data-theme', 'light');</script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <header class="bar">
      <div class="bar-side">
        <a href={home}>{s.barName}</a><span class="sep" aria-hidden="true"></span><span>{s.barRole}</span>
      </div>
      <nav class="bar-side" aria-label="Main">
        <a href={`${home}#about`}>{s.barAbout}</a><span class="sep" aria-hidden="true"></span><a href={`${home}#contact`}>{s.barContact}</a>
        <span class="sep" aria-hidden="true"></span>
        {langs.map((l) => l === lang ? <span class="lang-on" aria-current="true">{l}</span> : <a class="lang-off" href={switchPath(path, l)} hreflang={l} lang={l}>{l}</a>)}
      </nav>
    </header>
    <main id="main">
      <slot name="hero" />
      <div class="container">
        <slot />
      </div>
    </main>
    <div class="container">
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href={home}>{s.home}</a>
          {s.nav.map((item) => <a href={`${home}#${item.hash}`}>{item.label}</a>)}
        </nav>
        <div class="footer-right">
          {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
          <a href={`mailto:${site.email}`}>Email</a>
          <span class="subtle">© {year}</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .bar {
    position: sticky; top: 0; z-index: 30; height: 54px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 0 40px; background: #000; color: #fff; font-size: 16px; text-transform: lowercase;
  }
  .bar-side { display: flex; align-items: center; gap: 16px; white-space: nowrap; }
  .bar a { color: #fff; transition: opacity .2s ease; }
  .bar a:hover { color: #fff; opacity: .6; }
  .sep { width: 1px; height: 14px; background: currentColor; opacity: .8; }
  .lang-on { font-weight: 600; }
  .lang-off { opacity: .55; }
  @media (max-width: 640px) {
    .bar { padding: 0 16px; font-size: 14px; gap: 12px; }
    .bar-side { gap: 10px; }
    .bar-side:first-child .sep, .bar-side:first-child > span:last-child { display: none; }
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 120px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
  }
  .site-footer nav, .footer-right { display: flex; flex-wrap: wrap; gap: 4px 24px; align-items: center; }
  .site-footer a { padding: 8px 0; }
</style>
