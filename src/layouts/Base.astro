---
import '../styles/global.css';
import { site } from '../site';
import { t, prefix, switchPath, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** home: the header floats over a full-screen hero passed in the "hero" slot */
  overlay?: boolean;
  /** which tab is highlighted */
  active?: 'work' | 'about' | 'contact';
}
const { lang, active = 'work' } = Astro.props;
const s = t[lang];
const title = Astro.props.title ?? s.siteTitle;
const description = Astro.props.description ?? s.description;
const path = Astro.url.pathname;
const home = `${prefix(lang)}/`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.site ? new URL(path, Astro.site) : null;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(switchPath(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchPath(path, 'en'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light" />
    <script is:inline>document.documentElement.setAttribute('data-theme', 'light');</script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <nav class="tabs" aria-label="Main">
      {s.nav.map((item, k) => (
        <a href={`${home}#${item.hash}`} class:list={["tab", { "tab--on": k === 0 && active === 'work' }]} aria-current={k === 0 && active === 'work' ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <main id="main">
      <slot name="hero" />
      <div class="container">
        <slot />
      </div>
    </main>
    <div class="container">
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href={home}>{s.home}</a>
          {s.nav.map((item) => <a href={`${home}#${item.hash}`}>{item.label}</a>)}
        </nav>
        <div class="footer-right">
          <span class="lang" role="group" aria-label={s.langLabel}>
            {langs.map((l) => l === lang ? <span aria-current="true">{l.toUpperCase()}</span> : <a href={switchPath(path, l)} hreflang={l} lang={l}>{l.toUpperCase()}</a>)}
          </span>
          {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
          <a href={`mailto:${site.email}`}>Email</a>
          <span class="subtle">© {year}</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  /* Tab bar: three equal cells across the full width. */
  .tabs { position: sticky; top: 0; z-index: 10; display: grid; grid-template-columns: repeat(3, 1fr); }
  .tab {
    display: flex; align-items: center; justify-content: center; height: 54px;
    font-size: 16px; color: #000; background: #F7F8FD; transition: background-color .25s ease;
  }
  .tab:hover { color: #000; background: #EBEEFA; }
  .tab--on, .tab--on:hover { background: #DFE7FF; }
  .lang { display: inline-flex; gap: 10px; font-weight: 600; }
  .lang a { color: var(--color-text-subtle); }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 120px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
  }
  .site-footer nav, .footer-right { display: flex; flex-wrap: wrap; gap: 4px 24px; align-items: center; }
  .site-footer a { padding: 8px 0; }
</style>
