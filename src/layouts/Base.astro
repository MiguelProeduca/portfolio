---
import '../styles/global.css';
import { site } from '../site';
import { t, prefix, switchPath, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** home: the header floats over a full-screen hero passed in the "hero" slot */
  overlay?: boolean;
}
const { lang, overlay = false } = Astro.props;
const s = t[lang];
const title = Astro.props.title ?? s.siteTitle;
const description = Astro.props.description ?? s.description;
const path = Astro.url.pathname;
const home = `${prefix(lang)}/`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.site ? new URL(path, Astro.site) : null;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(switchPath(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchPath(path, 'en'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <div class:list={["container", "header-wrap", { "header-wrap--overlay": overlay }]}>
      <header class="site-header">
        <a href={home} class="brand">{site.name}</a>
        <div class="header-right">
          <nav aria-label="Main">
            <ul>
              {s.nav.map((item) => (
                <li><a href={`${home}#${item.hash}`}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <button class="theme-toggle" type="button" aria-label={s.themeLabel} aria-pressed="false">
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          </button>
          <div class="lang" role="group" aria-label={s.langLabel}>
            {langs.map((l) =>
              l === lang ? (
                <span aria-current="true">{l.toUpperCase()}</span>
              ) : (
                <a href={switchPath(path, l)} hreflang={l} lang={l}>{l.toUpperCase()}</a>
              ),
            )}
          </div>
        </div>
      </header>
    </div>
    <main id="main">
      <slot name="hero" />
      <div class="container">
        <slot />
      </div>
    </main>
    <div class="container">
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href={home}>{s.home}</a>
          {s.nav.map((item) => <a href={`${home}#${item.hash}`}>{item.label}</a>)}
        </nav>
        <div class="footer-right">
          {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
          <a href={`mailto:${site.email}`}>Email</a>
          <span class="subtle">© {year}</span>
        </div>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('.theme-toggle');
        function sync() { btn.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark')); }
        sync();
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    padding: 24px 0;
  }
  .header-wrap--overlay { position: absolute; top: 8px; left: 0; right: 0; z-index: 2; }
  .header-wrap--overlay .site-header { padding: 24px 0; }
  .theme-toggle {
    display: inline-grid; place-items: center; width: 40px; height: 40px; margin: 0 -8px;
    border: 0; border-radius: 999px; background: transparent; color: inherit; cursor: pointer;
  }
  .theme-toggle:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
  .theme-toggle .i-sun { display: none; }
  :global([data-theme="dark"]) .theme-toggle .i-sun { display: block; }
  :global([data-theme="dark"]) .theme-toggle .i-moon { display: none; }
  .brand { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
  .header-right { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px; }
  nav ul { display: flex; flex-wrap: wrap; gap: 4px 28px; list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-block; padding: 12px 0; font-size: 15px; }
  .lang { display: flex; gap: 10px; font-size: 13px; font-weight: 500; }
  .lang > * { display: inline-block; padding: 12px 0; }
  .lang a { color: var(--color-text-subtle); }
  .lang a:hover { color: var(--color-text); }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 120px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
  }
  .site-footer nav, .footer-right { display: flex; flex-wrap: wrap; gap: 4px 24px; align-items: center; }
  .site-footer a { padding: 8px 0; }
</style>
