---
import Screen from './Screen.astro';
import { site } from '../site';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
---
<Screen lang={lang} active="home" image="/hero-collage.webp" imageAlt={s.heroAlt}>
  <div class="intro">
    <p class="t-name">{site.name}</p>
    <h1 class="t-role">{s.role}</h1>
  </div>
  <p class="t-lead">{s.heroSub}</p>
</Screen>

<style>
  .intro { display: flex; flex-direction: column; gap: clamp(20px, 2.2vw, 42px); }
</style>
