---
import Base from '../layouts/Base.astro';
import TokenFigure from './TokenFigure.astro';
import { t, prefix, type Lang } from '../i18n';
import { getCases, slugOf, pad } from '../cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const cases = await getCases(lang);
const base = prefix(lang);
---
<Base lang={lang}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="label label--muted tags">
        {s.tags.map((tag, i) => (
          <>{i > 0 && <span aria-hidden="true">/</span>}<span>{tag}</span></>
        ))}
      </p>
      <h1 id="hero-title">{s.h1}</h1>
      <p class="sub">{s.sub}</p>
      <div class="actions">
        <a href="#work" class="btn btn--solid">{s.seeWork} <span aria-hidden="true">→</span></a>
        <a href="#contact" class="btn btn--line">{s.getInTouch}</a>
      </div>
    </div>
    <div class="hero-figure">
      <TokenFigure lang={lang} />
    </div>
  </section>

  <section id="work" class="work" aria-labelledby="work-title">
    <div class="section-head label">
      <h2 id="work-title">{s.selectedWork}</h2>
      <span class="label--muted">{pad(cases.length)} {s.cases}</span>
    </div>
    <ul class="case-list">
      {cases.map((c) => (
        <li>
          <a href={`${base}/work/${slugOf(c.id)}/`} class="case-row">
            <span class="label label--subtle num">{pad(c.data.order)}</span>
            <span class="case-main">
              <span class="case-title">{c.data.title}</span>
              <span class="case-summary">{c.data.summary}</span>
            </span>
            <span class="label label--muted">{c.data.tag}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="how" class="split block" aria-labelledby="how-title">
    <div class="block-head">
      <span class="label label--subtle">{s.howLabel}</span>
      <h2 id="how-title">{s.howTitle}</h2>
    </div>
    <div>
      <p class="intro muted">{s.howIntro}</p>
      <dl class="rows">
        {s.how.map((r) => (
          <div class="row">
            <dt class="label">{r.k}</dt>
            <dd class="muted">{r.v}</dd>
          </div>
        ))}
        <div class="row row--key">
          <dt class="label"><span class="dot" aria-hidden="true"></span>{s.notDelegatedK}</dt>
          <dd>{s.notDelegatedV}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="about" class="split block" aria-labelledby="about-title">
    <div>
      <h2 id="about-title" class="label label--subtle">{s.aboutLabel}</h2>
    </div>
    <div class="about">
      {s.about.map((p) => <p>{p}</p>)}
      <p class="muted">{s.aboutLast}</p>
    </div>
  </section>

  <section id="experience" class="split block" aria-labelledby="exp-title">
    <div>
      <h2 id="exp-title" class="label label--subtle">{s.experienceLabel}</h2>
    </div>
    <div>
      <ul class="exp">
        {s.experience.map((e) => (
          <li>
            <span class="exp-co">{e.company}</span>
            <span class="muted exp-role">{e.role}</span>
            <span class="label label--muted">{e.dates}</span>
          </li>
        ))}
      </ul>
      <p class="edu muted">{s.education}</p>
    </div>
  </section>
</Base>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; padding: 96px 0 104px; }
  .hero-text { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 32px; }
  .hero-figure { flex: 1 1 380px; min-width: 0; }
  .tags { margin: 0; display: flex; flex-wrap: wrap; gap: 16px; }
  .tags [aria-hidden] { color: var(--color-decor); }
  h1 {
    margin: 0;
    font-size: clamp(40px, 5.4vw, 76px);
    line-height: 1.02;
    font-weight: 400;
    letter-spacing: -0.035em;
    max-width: 13ch;
  }
  .sub { margin: 0; font-size: 18px; line-height: 1.55; color: var(--color-text-muted); max-width: 46ch; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 10px;
    min-height: 44px; padding: 0 20px;
    border-radius: var(--p-radius-pill);
    font-size: 14px; font-weight: 500;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn--solid { background: var(--color-inverse-bg); color: var(--color-inverse-text); }
  .btn--solid:hover { color: var(--color-inverse-text); background: var(--color-text-muted); }
  .btn--line { border: 1px solid var(--color-border-control); }
  .btn--line:hover { color: var(--color-text); border-color: var(--color-text); }

  .work { padding: 24px 0 96px; }
  .section-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    border-bottom: 1px solid var(--color-border-strong); padding-bottom: 14px;
  }
  .section-head h2 { margin: 0; font: inherit; font-weight: 500; }
  .case-list { list-style: none; margin: 0; padding: 0; }
  .case-row {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 32px;
    padding: 28px 0; border-bottom: 1px solid var(--color-border);
  }
  .case-row:hover { color: inherit; }
  .num { width: 32px; }
  .case-main { flex: 999 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .case-title { font-size: 26px; letter-spacing: -0.02em; transition: transform 0.2s ease; }
  .case-summary { font-size: 15px; color: var(--color-text-muted); }
  .arrow { font-size: 18px; transition: color 0.15s ease, transform 0.2s ease; }
  .case-row:hover .arrow { color: var(--color-accent); transform: translate(2px, -2px); }
  .case-row:hover .case-title { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) {
    .case-row:hover .case-title, .case-row:hover .arrow { transform: none; }
  }

  .block { padding: 0 0 96px; }
  .block-head { display: flex; flex-direction: column; gap: 12px; }
  .block-head h2 {
    margin: 0; font-size: 32px; line-height: 1.12; font-weight: 400;
    letter-spacing: -0.025em; max-width: 14ch;
  }
  .block h2.label { margin: 0; font-weight: 400; }
  .intro { margin: 0 0 24px; font-size: 17px; line-height: 1.6; max-width: 56ch; }
  .rows { margin: 0; }
  .row {
    display: flex; flex-wrap: wrap; gap: 8px 24px;
    padding: 18px 0; border-top: 1px solid var(--color-border);
  }
  .row dt { width: 160px; display: inline-flex; align-items: center; gap: 8px; }
  .row dd { flex: 1 1 320px; margin: 0; font-size: 15px; line-height: 1.55; }
  .row--key { border-top-color: var(--color-border-strong); border-bottom: 1px solid var(--color-border); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }

  .about { display: flex; flex-direction: column; gap: 20px; font-size: 19px; line-height: 1.6; }
  .about p { margin: 0; max-width: 640px; }

  .exp { list-style: none; margin: 0; padding: 0; font-size: 15px; }
  .exp li {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 24px;
    padding: 16px 0; border-top: 1px solid var(--color-border);
  }
  .exp li:first-child { border-top-color: var(--color-border-strong); }
  .exp li:last-child { border-bottom: 1px solid var(--color-border); }
  .exp-co { flex: 1 1 200px; }
  .exp-role { flex: 1 1 220px; }
  .edu { margin: 20px 0 0; font-size: 14px; line-height: 1.6; max-width: 640px; }
</style>
