---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { t, prefix, type Lang } from '../i18n';
import { getCases, slugOf } from '../cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const cases = await getCases(lang);
const base = prefix(lang);
const projectLinks = cases.flatMap((c) =>
  (c.data.heroLinks ?? [{ label: c.data.cardTitle ?? c.data.title, type: c.data.kicker }]).map((l) => ({
    ...l,
    href: `${base}/work/${slugOf(c.id)}/${l.hash ? '#' + l.hash : ''}`,
    cover: c.data.cover,
  })),
);
const pile = [
  { src: '/pile/c57.webp', l: 74.448, t: 12.047, w: 31.908 },
  { src: '/pile/c71.webp', l: 14.609, t: 24.387, w: 28.081 },
  { src: '/pile/c72.webp', l: 18.898, t: 50.067, w: 26.806 },
  { src: '/pile/c73.webp', l: 35.633, t: 8.999, w: 24.123 },
  { src: '/pile/c74.webp', l: 48.646, t: 10.733, w: 23.296 },
  { src: '/pile/c75.webp', l: 61.195, t: 42.460, w: 28.349 },
  { src: '/pile/c76.webp', l: 36.250, t: 35.636, w: 27.500 },
];
---
<Base lang={lang}>
  <section class="pile" slot="hero" aria-label={s.photoAlt}>
    <h1 class="sr-only">{s.h1a} {s.h1b}</h1>
    {pile.map((c, k) => (
      <span class="pc" style={`left:${c.l}%;top:${c.t}%;width:${c.w}%;--d:${k}`}>
        <img src={c.src} alt="" draggable="false" />
      </span>
    ))}
  </section>

  <section id="about" class="split" aria-labelledby="about-title">
    <h2 id="about-title" class="h2">{s.aboutLabel}</h2>
    <div class="text">
      {s.about.map((p, i) => <p class={i === 0 ? 'big' : 'muted'}>{p}</p>)}
      <p class="muted">{s.aboutLast}</p>
    </div>
  </section>

  <section id="how" class="split" aria-labelledby="how-title">
    <h2 id="how-title" class="h2">{s.howLabel}</h2>
    <div class="text">
      <p class="big">{s.howTitle} <span class="subtle">{s.howIntro}</span></p>
      <ul class="rows">
        {s.how.map((r) => (
          <li><span class="row-k">{r.k}</span><span class="muted">{r.v}</span></li>
        ))}
        <li><span class="row-k">{s.notDelegatedK}</span><span class="muted">{s.notDelegatedV}</span></li>
      </ul>
    </div>
  </section>

  {site.photo && (
    <figure class="photo">
      <img src={site.photo} alt={s.photoAlt} loading="lazy" />
    </figure>
  )}

  <section id="experience" class="split" aria-labelledby="exp-title">
    <h2 id="exp-title" class="h2">{s.experienceLabel}</h2>
    <div class="text">
      <ul class="rows exp">
        {s.experience.map((e) => (
          <li>
            <span class="row-k">{e.company}</span>
            <span class="muted exp-role">{e.role}</span>
            <span class="subtle">{e.dates}</span>
          </li>
        ))}
      </ul>
      <p class="edu subtle">{s.education}</p>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{s.contactTitle}</h2>
    <a class="mail" href={`mailto:${site.email}`}><span aria-hidden="true">→</span> {site.email}</a>
    <p class="subtle">{s.availability}</p>
  </section>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* A loose pile of cards, positioned as in the Figma (1920 × 1187 stage). */
  .pile { position: relative; width: 100%; aspect-ratio: 1920 / 1187; max-height: calc(100svh - 54px); overflow: hidden; margin: 0 auto; }
  @supports (aspect-ratio: 1) { .pile { max-width: calc((100svh - 54px) * 1920 / 1187); } }
  .pc {
    position: absolute; display: block;
    transition: transform .5s cubic-bezier(.2, .8, .2, 1), filter .5s ease;
    animation: drop .7s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--d) * 70ms);
  }
  .pc img { display: block; width: 100%; height: auto; pointer-events: none; user-select: none; }
  .pc:hover {
    z-index: 20; transform: translateY(-14px) scale(1.06) rotate(-2deg);
    filter: drop-shadow(0 28px 40px rgba(24, 28, 38, .28));
  }
  .pc:nth-child(odd):hover { transform: translateY(-14px) scale(1.06) rotate(2deg); }
  @keyframes drop { from { opacity: 0; transform: translateY(40px) scale(.96); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pc { animation: none; transition: none; } .pc:hover { transform: none; } }
  .cards { display: flex; flex-direction: column; gap: 24px; }
  .col { display: contents; }
  @media (min-width: 760px) {
    .cards { flex-direction: row; align-items: flex-start; gap: 32px; }
    .col { display: flex; flex-direction: column; gap: 32px; flex: 1 1 0; min-width: 0; }
  }
  .card {
    display: flex; flex-direction: column; height: 100%;
    background: var(--color-surface-muted);
    border-radius: var(--p-radius-md);
    overflow: hidden;
  }
  .card:hover { color: inherit; }
  .card-media {
    display: block; aspect-ratio: 4 / 3;
    background: var(--color-surface-strong);
    overflow: hidden;
  }
  .card--short .card-media { aspect-ratio: 6 / 5; }
  .card--tall .card-media { aspect-ratio: 1 / 1.08; }
  .card-media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
  }
  .card:hover .card-media img { transform: scale(1.025); }
  @media (prefers-reduced-motion: reduce) { .card:hover .card-media img { transform: none; } }
  /* caption floats over the image as frosted glass */
  .card { position: relative; }
  .card-text {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; flex-direction: column; gap: 2px;
    padding: 14px 20px 16px; font-size: 15px;
    background: rgba(232, 233, 230, 0.94);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .card-text {
      background: rgba(232, 233, 230, 0.62);
      -webkit-backdrop-filter: blur(18px) saturate(1.6);
      backdrop-filter: blur(18px) saturate(1.6);
    }
  }
  .card-text .subtle { color: var(--color-text-muted); }
  :global([data-theme="dark"]) .card-text { background: rgba(16, 18, 22, 0.92); border-top-color: rgba(255,255,255,.06); }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    :global([data-theme="dark"]) .card-text { background: rgba(16, 18, 22, 0.55); }
  }
  :global([data-theme="dark"]) .card--bordered::after { border-color: var(--color-border); }
  .card--bordered::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    border: 1px solid #D3DDE1; border-radius: inherit;
  }
  .card-title { font-weight: 500; }

  .text { display: flex; flex-direction: column; gap: 20px; font-size: 16px; line-height: 1.6; }
  .text p { margin: 0; max-width: 620px; }
  .text .big { font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; color: var(--color-text); letter-spacing: -0.01em; }
  .text .rows { margin-top: 12px; }
  .rows li { display: flex; flex-direction: column; gap: 4px; }
  .row-k { font-weight: 500; }
  .exp li { display: grid; grid-template-columns: 1fr; gap: 2px; }
  .edu { font-size: 14px; }

  .contact {
    margin-top: 128px;
    padding: clamp(56px, 8vw, 104px) 24px;
    background: var(--color-surface-muted);
    border-radius: var(--p-radius-lg);
    display: flex; flex-direction: column; align-items: center; gap: 20px;
    text-align: center;
  }
  .contact h2 {
    margin: 0; max-width: 16ch;
    font-size: clamp(30px, 4vw, 52px); line-height: 1.08;
    font-weight: 600; letter-spacing: -0.035em;
  }
  .mail { font-size: clamp(18px, 2vw, 24px); font-weight: 500; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .contact p { margin: 0; font-size: 14px; }
</style>
