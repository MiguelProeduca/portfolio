---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { t, prefix, type Lang } from '../i18n';
import { getCases, slugOf } from '../cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const cases = await getCases(lang);
const base = prefix(lang);
---
<Base lang={lang}>
  <section class="hero">
    <h1>{s.h1a} <span class="subtle">{s.h1b}</span></h1>
  </section>

  <section id="work" class="work" aria-labelledby="work-title">
    <h2 id="work-title" class="work-head">{s.selectedWork} <span class="subtle">· {s.workYears}</span></h2>
    <ul class="cards">
      {cases.map((c, i) => (
        <li class={i === 0 ? 'wide' : ''}>
          <a href={`${base}/work/${slugOf(c.id)}/`} class="card">
            <span class="card-media">
              {c.data.cover && <img src={c.data.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} />}
            </span>
            <span class="card-text">
              <span class="card-title">{c.data.title}</span>
              <span class="subtle">{c.data.kicker}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="about" class="split" aria-labelledby="about-title">
    <h2 id="about-title" class="h2">{s.aboutLabel}</h2>
    <div class="text">
      {s.about.map((p, i) => <p class={i === 0 ? 'big' : 'muted'}>{p}</p>)}
      <p class="muted">{s.aboutLast}</p>
    </div>
  </section>

  <section id="how" class="split" aria-labelledby="how-title">
    <h2 id="how-title" class="h2">{s.howLabel}</h2>
    <div class="text">
      <p class="big">{s.howTitle} <span class="subtle">{s.howIntro}</span></p>
      <ul class="rows">
        {s.how.map((r) => (
          <li><span class="row-k">{r.k}</span><span class="muted">{r.v}</span></li>
        ))}
        <li><span class="row-k">{s.notDelegatedK}</span><span class="muted">{s.notDelegatedV}</span></li>
      </ul>
    </div>
  </section>

  <section id="experience" class="split" aria-labelledby="exp-title">
    <h2 id="exp-title" class="h2">{s.experienceLabel}</h2>
    <div class="text">
      <ul class="rows exp">
        {s.experience.map((e) => (
          <li>
            <span class="row-k">{e.company}</span>
            <span class="muted exp-role">{e.role}</span>
            <span class="subtle">{e.dates}</span>
          </li>
        ))}
      </ul>
      <p class="edu subtle">{s.education}</p>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{s.contactTitle}</h2>
    <a class="mail" href={`mailto:${site.email}`}><span aria-hidden="true">→</span> {site.email}</a>
    <p class="subtle">{s.availability}</p>
  </section>
</Base>

<style>
  .hero { padding: clamp(72px, 10vw, 136px) 0 clamp(96px, 12vw, 168px); }
  h1 {
    margin: 0;
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.035em;
    max-width: 21ch;
  }

  .work-head { margin: 0 0 24px; font-size: 16px; font-weight: 500; }
  .cards {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr; gap: 24px;
  }
  @media (min-width: 760px) {
    .cards { grid-template-columns: 1fr 1fr; gap: 32px; }
    .cards .wide { grid-column: 1 / -1; }
  }
  .card {
    display: flex; flex-direction: column; height: 100%;
    background: var(--color-surface-muted);
    border-radius: var(--p-radius-md);
    overflow: hidden;
  }
  .card:hover { color: inherit; }
  .card-media {
    display: block; aspect-ratio: 4 / 3;
    background: var(--color-surface-strong);
    overflow: hidden;
  }
  .wide .card-media { aspect-ratio: 16 / 9; }
  @media (min-width: 760px) { .wide .card-media { aspect-ratio: 21 / 9; } }
  .card-media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
  }
  .card:hover .card-media img { transform: scale(1.025); }
  @media (prefers-reduced-motion: reduce) { .card:hover .card-media img { transform: none; } }
  .card-text { display: flex; flex-direction: column; gap: 2px; padding: 16px 20px 20px; font-size: 15px; }
  .card-title { font-weight: 500; }

  .text { display: flex; flex-direction: column; gap: 20px; font-size: 16px; line-height: 1.6; }
  .text p { margin: 0; max-width: 620px; }
  .text .big { font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; color: var(--color-text); letter-spacing: -0.01em; }
  .text .rows { margin-top: 12px; }
  .rows li { display: flex; flex-direction: column; gap: 4px; }
  .row-k { font-weight: 500; }
  .exp li { display: grid; grid-template-columns: 1fr; gap: 2px; }
  .edu { font-size: 14px; }

  .contact {
    margin-top: 128px;
    padding: clamp(56px, 8vw, 104px) 24px;
    background: var(--color-surface-muted);
    border-radius: var(--p-radius-lg);
    display: flex; flex-direction: column; align-items: center; gap: 20px;
    text-align: center;
  }
  .contact h2 {
    margin: 0; max-width: 16ch;
    font-size: clamp(30px, 4vw, 52px); line-height: 1.08;
    font-weight: 600; letter-spacing: -0.035em;
  }
  .mail { font-size: clamp(18px, 2vw, 24px); font-weight: 500; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .contact p { margin: 0; font-size: 14px; }
</style>
