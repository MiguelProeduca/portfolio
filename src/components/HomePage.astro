---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { t, prefix, type Lang } from '../i18n';
import { getCases, slugOf } from '../cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const cases = await getCases(lang);
const base = prefix(lang);
---
<Base lang={lang} wide>
  <section class="hero" slot="hero">
    <div class="hero-text">
      <div class="hero-titles">
        <p class="hero-name">{site.name}</p>
        <h1>{s.role}</h1>
      </div>
      <p class="hero-sub">{s.heroSub}</p>
    </div>
    <div class="hero-media">
      <img src="/hero-collage.webp" alt={s.heroAlt} fetchpriority="high" />
    </div>
  </section>

  <section id="work" class="dark" slot="hero" aria-labelledby="work-title">
    <h2 id="work-title" class="band">{s.workBand}</h2>
    <ul class="grid">
      {cases.map((c, i) => (
        <li>
          <a href={`${base}/work/${slugOf(c.id)}/`} class="item">
            {c.data.cover && <img src={c.data.cover} style={c.data.coverPosition ? `object-position: ${c.data.coverPosition}` : undefined} alt="" loading={i < 2 ? 'eager' : 'lazy'} />}
            <span class="item-caption">
              <span class="item-co">{c.data.company ?? c.data.kicker} <span class="item-year">{c.data.year}</span></span>
              <span class="item-sub">{c.data.cardTitle ?? c.data.title}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="about" slot="hero" aria-labelledby="about-title">
    <h2 id="about-title" class="band">{s.aboutTag}</h2>
    <div class="about">
      <div class="about-photo"><img src="/portrait-tall.webp" alt={s.portraitAlt} loading="lazy" /></div>
      <div class="about-text">
        <h3>{s.aboutTitle}</h3>
        {s.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="experience" slot="hero" aria-labelledby="exp-title">
    <h2 id="exp-title" class="band">{s.experienceLabel}</h2>
    <div class="exp">
      <ul class="jobs">
        {s.experience.map((e) => (
          <li>
            <span class="job-dates">{e.dates}</span>
            <span class="job-role">{e.role}</span>
            <span class="job-co">{e.company}</span>
          </li>
        ))}
      </ul>
      <p class="edu">{s.education}</p>
    </div>
  </section>

  <section id="contact" slot="hero" aria-labelledby="contact-title">
    <h2 id="contact-title" class="band">{s.contactBand}</h2>
    <div class="contact">
      <p class="contact-title">{s.contactTitle}</p>
      <a class="contact-mail" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">→</span></a>
      <p class="contact-note">{s.availability}</p>
    </div>
  </section>
</Base>

<style>
  /* Black and white, big tight grotesk in capitals: the hero splits text and collage,
     black bands carry each section title. */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.81fr); min-height: calc(100svh - 72px); background: #fff; }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; min-height: 0; } }
  .hero-text {
    display: flex; flex-direction: column; justify-content: center; gap: clamp(32px, 3.4vw, 58px);
    padding: 48px var(--gutter); color: #000; text-transform: uppercase;
    font-family: var(--font-display); font-weight: 600;
  }
  .hero-titles { display: flex; flex-direction: column; gap: clamp(20px, 2.4vw, 42px); }
  .hero-name { margin: 0; font-size: clamp(30px, 4.6vw, 79px); line-height: 1.04; letter-spacing: -0.04em; }
  .hero h1 { margin: 0; font-size: clamp(46px, 7.4vw, 128px); line-height: .86; letter-spacing: -0.06em; font-weight: 600; }
  .hero-sub { margin: 0; max-width: 34ch; font-size: clamp(17px, 2.08vw, 36px); line-height: 1.06; letter-spacing: -0.01em; }
  .hero-media { position: relative; min-height: 420px; }
  .hero-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 860px) { .hero-media { aspect-ratio: 4 / 5; min-height: 0; } }

  /* intro: the two halves come in from the sides and meet in the middle, then the words rise */
  .hero { overflow: hidden; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-text { animation: from-left 1.1s cubic-bezier(.7, 0, .2, 1) both; }
    .hero-media { animation: from-right 1.1s cubic-bezier(.7, 0, .2, 1) both; }
    .hero-media img { animation: settle 1.8s cubic-bezier(.2, .7, .2, 1) both; }
    .hero-name, .hero h1, .hero-sub { animation: rise .8s cubic-bezier(.2, .7, .2, 1) both; }
    .hero-name { animation-delay: .7s; }
    .hero h1 { animation-delay: .82s; }
    .hero-sub { animation-delay: .96s; }
  }
  @keyframes from-left { from { transform: translateX(-100%); } }
  @keyframes from-right { from { transform: translateX(100%); } }
  @keyframes settle { from { transform: scale(1.15); } }
  @keyframes rise { from { opacity: 0; transform: translateY(32px); } }

  .band {
    margin: 0; padding: clamp(24px, 2.8vw, 48px) var(--gutter); background: #000; color: #F6F6F6; text-align: center;
    font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: -0.04em;
    font-size: clamp(56px, 9.5vw, 164px); line-height: 1.1;
  }

  .dark { background: #000; color: #fff; }
  .grid { list-style: none; margin: 0; padding: 0 var(--gutter) var(--gutter); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; gap: 16px; } }
  .item { position: relative; display: block; aspect-ratio: 1.03; overflow: hidden; background: #1a1a1a; color: #fff; }
  .item:hover { color: #fff; }
  .item img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2, .7, .2, 1); }
  .item:hover img { transform: scale(1.03); }
  /* caption sits on the image: always on touch, on hover with a mouse */
  .item-caption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 64px 24px 22px;
    display: flex; flex-direction: column; gap: 4px;
    background: linear-gradient(to top, rgba(0,0,0,.72), rgba(0,0,0,0));
  }
  @media (hover: hover) {
    .item-caption { opacity: 0; transform: translateY(8px); transition: opacity .3s ease, transform .3s ease; }
    .item:hover .item-caption, .item:focus-visible .item-caption { opacity: 1; transform: none; }
  }
  .item-co { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: -0.03em; font-size: clamp(22px, 2.2vw, 36px); line-height: 1; }
  .item-year { opacity: .6; }
  .item-sub { font-size: 16px; opacity: .85; }

  .about { display: grid; grid-template-columns: minmax(0, 0.93fr) minmax(0, 1fr); gap: clamp(32px, 4.2vw, 72px); align-items: center; background: #fff; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } }
  .about-photo { position: relative; aspect-ratio: 832 / 911; overflow: hidden; }
  .about-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 70%; }
  .about-text { padding: 32px var(--gutter) 48px 0; color: #000; }
  @media (max-width: 860px) { .about-text { padding: 0 var(--gutter) 48px; } }
  .about-text h3 {
    margin: 0 0 clamp(24px, 2.8vw, 48px); font-family: var(--font-display); font-weight: 600; text-transform: uppercase;
    font-size: clamp(32px, 4.6vw, 79px); line-height: 1.02; letter-spacing: -0.04em;
  }
  .about-text p { margin: 0 0 16px; max-width: 46ch; font-size: clamp(17px, 1.62vw, 28px); line-height: 1.25; }

  .exp { padding: clamp(48px, 7vw, 120px) clamp(var(--gutter), 5vw, 88px); background: #fff; }
  .jobs { list-style: none; margin: 0; padding: 0; }
  .jobs li { display: grid; grid-template-columns: minmax(110px, 160px) minmax(0, 1fr) auto; align-items: center; gap: 8px 32px; padding: clamp(22px, 2.3vw, 40px) 0; border-bottom: 1px solid #D6DCF5; }
  .jobs li:first-child { border-top: 1px solid #D6DCF5; }
  .job-dates { font-size: clamp(15px, 1.4vw, 24px); letter-spacing: -0.04em; color: #5A6481; }
  .job-role { font-size: clamp(20px, 2.3vw, 40px); font-weight: 500; letter-spacing: -0.025em; color: #000; }
  .job-co { font-size: clamp(15px, 1.4vw, 24px); color: #5A6481; text-align: right; }
  @media (max-width: 720px) { .jobs li { grid-template-columns: 1fr auto; } .job-dates { grid-column: 1 / -1; } }
  .edu { margin: 34px 0 0; font-size: clamp(15px, 1.4vw, 24px); line-height: 1.4; font-weight: 500; letter-spacing: -0.02em; color: #4A5268; }

  .contact { display: flex; flex-direction: column; align-items: center; gap: 24px; padding: clamp(56px, 8vw, 120px) var(--gutter); text-align: center; background: #fff; }
  .contact-title { margin: 0; max-width: 20ch; color: #000; font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: -0.04em; font-size: clamp(30px, 4.6vw, 79px); line-height: 1.02; }
  .contact-mail { font-size: clamp(20px, 2.3vw, 40px); font-weight: 500; letter-spacing: -0.025em; color: #000; overflow-wrap: anywhere; }
  .contact-mail:hover { color: #5A6481; }
  .contact-note { margin: 0; font-size: 15px; color: #5A6481; }
</style>
