---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { t, prefix, type Lang } from '../i18n';
import { getCases, slugOf } from '../cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const cases = await getCases(lang);
const base = prefix(lang);
---
<Base lang={lang} overlay>
  <section class="hero" slot="hero">
    <img class="hero-bg hero-bg--light" src="/collage.jpg" alt={s.photoAlt} fetchpriority="high" />
    <img class:list={["hero-bg", "hero-bg--dark", { "hero-bg--dimmed": !site.collageDark }]} src={site.collageDark || '/collage.jpg'} alt="" />
    <div class="hero-text">
      <h1>{s.h1a} <span class="hero-soft">{s.h1b}</span></h1>
      <p class="hero-sub">{s.heroSub}</p>
    </div>
    <nav id="work" class="hero-projects" aria-label={s.selectedWork}>
      {cases.flatMap((c) => (c.data.heroLinks ?? [{ label: c.data.cardTitle ?? c.data.title, type: c.data.kicker }]).map((l) => (
        <a href={`${base}/work/${slugOf(c.id)}/${l.hash ? '#' + l.hash : ''}`} class="hp">
          <span class="hp-label"><span><span class="hp-name">{l.label}</span> · <span class="hp-type">{l.type}</span></span></span>
        </a>
      )))}
    </nav>
  </section>


  <section id="about" class="split" aria-labelledby="about-title">
    <h2 id="about-title" class="h2">{s.aboutLabel}</h2>
    <div class="text">
      {s.about.map((p, i) => <p class={i === 0 ? 'big' : 'muted'}>{p}</p>)}
      <p class="muted">{s.aboutLast}</p>
    </div>
  </section>

  <section id="how" class="split" aria-labelledby="how-title">
    <h2 id="how-title" class="h2">{s.howLabel}</h2>
    <div class="text">
      <p class="big">{s.howTitle} <span class="subtle">{s.howIntro}</span></p>
      <ul class="rows">
        {s.how.map((r) => (
          <li><span class="row-k">{r.k}</span><span class="muted">{r.v}</span></li>
        ))}
        <li><span class="row-k">{s.notDelegatedK}</span><span class="muted">{s.notDelegatedV}</span></li>
      </ul>
    </div>
  </section>

  {site.photo && (
    <figure class="photo">
      <img src={site.photo} alt={s.photoAlt} loading="lazy" />
    </figure>
  )}

  <section id="experience" class="split" aria-labelledby="exp-title">
    <h2 id="exp-title" class="h2">{s.experienceLabel}</h2>
    <div class="text">
      <ul class="rows exp">
        {s.experience.map((e) => (
          <li>
            <span class="row-k">{e.company}</span>
            <span class="muted exp-role">{e.role}</span>
            <span class="subtle">{e.dates}</span>
          </li>
        ))}
      </ul>
      <p class="edu subtle">{s.education}</p>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{s.contactTitle}</h2>
    <a class="mail" href={`mailto:${site.email}`}><span aria-hidden="true">→</span> {site.email}</a>
    <p class="subtle">{s.availability}</p>
  </section>
</Base>

<style>
  .photo { margin: 104px 0 0; }
  .photo img { width: 100%; height: auto; border-radius: var(--p-radius-md); }
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    margin: 8px;
    height: calc(100svh - 16px); min-height: 560px;
    border-radius: var(--p-radius-lg);
    background: #E8E9E6;
    display: flex; align-items: flex-start;
  }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center bottom; z-index: -1; }
  .hero-bg { transition: opacity .7s cubic-bezier(.4, 0, .2, 1); }
  .hero-bg--dark { opacity: 0; }
  .hero-bg--dimmed { filter: brightness(.38) saturate(.75) contrast(1.05); }
  :global([data-theme="dark"]) .hero { background: #0B0D10; }
  :global([data-theme="dark"]) .hero-bg--light { opacity: 0; }
  :global([data-theme="dark"]) .hero-bg--dark { opacity: 1; }
  /* keep the headline legible where the peaks rise behind it on narrow screens */
  @media (max-width: 640px) {
    :global([data-theme="dark"]) .hero::before {
      content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background: linear-gradient(to bottom, rgba(8, 12, 14, .55), rgba(8, 12, 14, .35) 55%, transparent 75%);
    }
  }
  /* text lines up with the full-width nav above it */
  .hero-text {
    position: relative; z-index: 1;
    width: 100%;
    padding: clamp(120px, 15vh, 176px) clamp(12px, 2.2vw, 32px) 40px;
  }
  @media (max-width: 760px) { .hero-text { padding-top: 150px; } }
  .hero h1 { color: var(--color-heading); }
  .hero-soft { color: var(--color-heading-soft); }
  :global([data-theme="dark"]) .hero-sub { color: #C3C9CF; }
  .hero-sub { margin: 24px 0 0; max-width: 46ch; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: #3E5F74; }
  h1 {
    margin: 0;
    font-size: clamp(40px, 5.8vw, 72px);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.04em;
    max-width: 20ch;
  }

  .work { padding-top: clamp(64px, 8vw, 104px); }
  .hero { flex-direction: column; justify-content: space-between; }
  /* Bottom bar: just the project names. Hover shifts the colour. */
  .hero-projects {
    position: relative; z-index: 1; align-self: stretch;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 32px;
    padding: 20px clamp(12px, 2.2vw, 32px) 24px;
    color: var(--color-heading);
  }
  .hp { padding: 10px 0; font-size: 16px; transition: color .25s ease; }
  .hp:hover, .hp:focus-visible { color: var(--p-color-surface-0); }
  .hp-name { font-weight: 800; text-transform: uppercase; letter-spacing: .01em; }
  .hp-type { font-weight: 600; }
  :global([data-theme="dark"]) .hero-projects { color: #EDEDED; }
  :global([data-theme="dark"]) .hp:hover, :global([data-theme="dark"]) .hp:focus-visible { color: #A9BFC9; }
  @media (max-width: 760px) {
    .hero-projects { flex-direction: column; gap: 0; padding-bottom: 16px; }
    .hp { padding: 8px 0; font-size: 15px; }
  }
  :global([data-theme="dark"]) .hero-projects { color: #EDEDED; }
  @media (max-width: 760px) {
    .hero-projects { flex-direction: column; gap: 0; padding-bottom: 16px; }
    .hero-projects a { padding: 8px 0; }
  }
  .work-head { margin: 0 0 28px; font-size: clamp(22px, 2.2vw, 28px); font-weight: 700; letter-spacing: -0.025em; color: var(--color-heading); }
  .work-years { color: var(--color-heading-soft); font-weight: 600; }
  .cards { display: flex; flex-direction: column; gap: 24px; }
  .col { display: contents; }
  @media (min-width: 760px) {
    .cards { flex-direction: row; align-items: flex-start; gap: 32px; }
    .col { display: flex; flex-direction: column; gap: 32px; flex: 1 1 0; min-width: 0; }
  }
  .card {
    display: flex; flex-direction: column; height: 100%;
    background: var(--color-surface-muted);
    border-radius: var(--p-radius-md);
    overflow: hidden;
  }
  .card:hover { color: inherit; }
  .card-media {
    display: block; aspect-ratio: 4 / 3;
    background: var(--color-surface-strong);
    overflow: hidden;
  }
  .card--short .card-media { aspect-ratio: 6 / 5; }
  .card--tall .card-media { aspect-ratio: 1 / 1.08; }
  .card-media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
  }
  .card:hover .card-media img { transform: scale(1.025); }
  @media (prefers-reduced-motion: reduce) { .card:hover .card-media img { transform: none; } }
  /* caption floats over the image as frosted glass */
  .card { position: relative; }
  .card-text {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; flex-direction: column; gap: 2px;
    padding: 14px 20px 16px; font-size: 15px;
    background: rgba(232, 233, 230, 0.94);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .card-text {
      background: rgba(232, 233, 230, 0.62);
      -webkit-backdrop-filter: blur(18px) saturate(1.6);
      backdrop-filter: blur(18px) saturate(1.6);
    }
  }
  .card-text .subtle { color: var(--color-text-muted); }
  :global([data-theme="dark"]) .card-text { background: rgba(16, 18, 22, 0.92); border-top-color: rgba(255,255,255,.06); }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    :global([data-theme="dark"]) .card-text { background: rgba(16, 18, 22, 0.55); }
  }
  :global([data-theme="dark"]) .card--bordered::after { border-color: var(--color-border); }
  .card--bordered::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    border: 1px solid #D3DDE1; border-radius: inherit;
  }
  .card-title { font-weight: 500; }

  .text { display: flex; flex-direction: column; gap: 20px; font-size: 16px; line-height: 1.6; }
  .text p { margin: 0; max-width: 620px; }
  .text .big { font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; color: var(--color-text); letter-spacing: -0.01em; }
  .text .rows { margin-top: 12px; }
  .rows li { display: flex; flex-direction: column; gap: 4px; }
  .row-k { font-weight: 500; }
  .exp li { display: grid; grid-template-columns: 1fr; gap: 2px; }
  .edu { font-size: 14px; }

  .contact {
    margin-top: 128px;
    padding: clamp(56px, 8vw, 104px) 24px;
    background: var(--color-surface-muted);
    border-radius: var(--p-radius-lg);
    display: flex; flex-direction: column; align-items: center; gap: 20px;
    text-align: center;
  }
  .contact h2 {
    margin: 0; max-width: 16ch;
    font-size: clamp(30px, 4vw, 52px); line-height: 1.08;
    font-weight: 600; letter-spacing: -0.035em;
  }
  .mail { font-size: clamp(18px, 2vw, 24px); font-weight: 500; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .contact p { margin: 0; font-size: 14px; }
</style>
