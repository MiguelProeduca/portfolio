---
import Screen from './Screen.astro';
import { site } from '../site';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
---
<Screen lang={lang} active="contact" start={65} title={`${s.contactBand} · ${site.name}`} image="/collage-contact.webp" imageAlt="">
  <h1 class="t-title">{s.contactBig}</h1>
  <div class="mail-wrap">
    <a class="mail" href={`mailto:${site.email}`}><span aria-hidden="true">→</span> {site.email}</a>
    <p class="note">{s.availability}</p>
  </div>
</Screen>

<style>
  .mail-wrap { display: flex; flex-direction: column; gap: 16px; }
  .mail { font-weight: 600; font-size: clamp(20px, calc(2.7vw - 2.6px), 55px); line-height: 1; letter-spacing: -0.07em; color: #000; overflow-wrap: anywhere; }
  .mail:hover { color: #5A6481; }
  .note { margin: 0; font-size: clamp(13px, .9vw, 16px); color: #5A6481; }
</style>
