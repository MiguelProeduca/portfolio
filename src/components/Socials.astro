---
<ul class:list={["socials", cls]}>
  {site.social.map((s) => (
    <li>
      {s.url ? (
        <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" set:html={icons[s.key]} /></a>
      ) : (
        <span title={s.label}><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" set:html={icons[s.key]} /></span>
      )}
    </li>
  ))}
</ul>

<style>
  .socials { display: flex; align-items: center; gap: clamp(14px, 1.25vw, 24px); list-style: none; margin: 0; padding: 0; color: #fff; }
  .socials li { display: flex; }
  .socials a, .socials span { display: flex; padding: 4px; color: inherit; opacity: .92; transition: opacity .2s ease; }
  .socials a:hover { opacity: 1; color: inherit; }
  .socials svg { display: block; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .25)); }
</style>
