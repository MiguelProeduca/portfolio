---
// Social icons, white, top right of each screen (or inside the dark bar on the work page).
import { site } from '../site';

interface Props { class?: string }
const { class: cls } = Astro.props;
const icons: Record<string, string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor"/>',
  behance: '<text x="12" y="17" text-anchor="middle" font-family="Inter, sans-serif" font-weight="800" font-size="13" letter-spacing="-0.5" fill="currentColor">Bē</text>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="2" fill="currentColor"/><text x="12.3" y="17.2" text-anchor="middle" font-family="Inter, sans-serif" font-weight="800" font-size="11" letter-spacing="-0.4" fill="#181C26">in</text>',
  soundcloud: '<path d="M10 17V8.6c.9-.5 1.9-.8 3-.8 3 0 5.4 2.2 5.8 5.1.4-.2.8-.2 1.2-.2 1.7 0 3 1.3 3 2.9S21.7 17 20 17H10Z" fill="currentColor"/><path d="M8 17V10M6 17v-5M4 17v-3.5M2 17v-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
};
---
<ul class:list={["socials", cls]}>
  {site.social.map((s) => (
    <li>
      {s.url ? (
        <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={icons[s.key]} /></a>
      ) : (
        <span title={s.label}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={icons[s.key]} /></span>
      )}
    </li>
  ))}
</ul>

<style>
  .socials { display: flex; align-items: center; gap: 14px; list-style: none; margin: 0; padding: 0; color: #fff; }
  .socials li { display: flex; }
  .socials a, .socials span { display: flex; padding: 4px; color: inherit; opacity: .92; transition: opacity .2s ease; }
  .socials a:hover { opacity: 1; color: inherit; }
  .socials svg { display: block; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .25)); }
</style>
