---
import Screen from './Screen.astro';
import { site } from '../site';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
---
<Screen lang={lang} active="experience" start={65} title={`${s.experienceLabel} · ${site.name}`} image="/collage-experience.webp" imageAlt="">
  <h1 class="t-title">{s.whereWorked}</h1>
  <div class="exp">
    <ul class="jobs">
      {s.experience.map((e) => (
        <li>
          <span class="job-dates">{e.dates}</span>
          <span class="job-role">{e.role}</span>
          <span class="job-co">{e.company}</span>
        </li>
      ))}
    </ul>
    <p class="edu">{s.education}</p>
  </div>
</Screen>

<style>
  .exp { display: flex; flex-direction: column; gap: clamp(20px, 1.8vw, 34px); }
  .jobs { list-style: none; margin: 0; padding: 0; }
  .jobs li { display: grid; grid-template-columns: minmax(88px, 110px) minmax(0, 1fr) auto; align-items: center; gap: 6px clamp(16px, 1.7vw, 32px); padding: clamp(18px, 1.7vw, 32px) 0; border-bottom: 1px solid #D6DCF5; }
  .jobs li:first-child { border-top: 1px solid #D6DCF5; }
  .job-dates { font-size: clamp(13px, .83vw, 16px); letter-spacing: -0.04em; color: #5A6481; }
  .job-role { font-size: clamp(17px, min(3.2cqi, calc(1.6vw - 1.5px)), 32px); font-weight: 500; letter-spacing: -0.03em; color: #000; line-height: 1.1; }
  .job-co { font-size: clamp(13px, .83vw, 16px); color: #5A6481; text-align: right; }
  @media (max-width: 560px) { .jobs li { grid-template-columns: 1fr auto; } .job-dates { grid-column: 1 / -1; } }
  .edu { margin: 0; font-size: clamp(13px, min(2.4cqi, calc(1.2vw - 1.2px)), 24px); line-height: 1.4; font-weight: 500; letter-spacing: -0.04em; color: #4A5268; }
</style>
