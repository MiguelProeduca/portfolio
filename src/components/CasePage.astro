---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { t, prefix, type Lang } from '../i18n';
import { slugOf } from '../cases';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { lang, entry, next } = Astro.props;
const s = t[lang];
const { Content } = await render(entry);
---
<Base lang={lang} title={`${entry.data.title} · ${site.name}`} description={entry.data.summary}>
  <section class="intro">
    <span class="subtle kicker">{entry.data.kicker}</span>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.lead}</p>
  </section>

  <dl class="meta">
    {entry.data.meta.map((m) => (
      <div>
        <dt class="subtle">{m.label}</dt>
        <dd>{m.value}</dd>
      </div>
    ))}
  </dl>

  {entry.data.cover ? (
    <img class="hero hero-img" src={entry.data.cover} alt={entry.data.hero.replace(/^\[|\]$/g, '')} />
  ) : (
    <div class="placeholder hero">{entry.data.hero}</div>
  )}

  <article class="prose">
    <Content />
  </article>

  <a class="next" href={`${prefix(lang)}/work/${slugOf(next.id)}/`}>
    <span class="subtle">{s.nextCase}</span>
    <span class="next-title">{next.data.title} <span aria-hidden="true">→</span></span>
  </a>
</Base>

<style>
  .intro { padding: clamp(64px, 9vw, 120px) 0 56px; display: flex; flex-direction: column; gap: 20px; }
  .kicker { font-size: 15px; }
  h1 {
    margin: 0;
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }
  .lead { margin: 0; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: var(--color-text-muted); max-width: 54ch; }

  .meta {
    margin: 0 0 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0 32px;
    border-top: 1px solid var(--color-border);
  }
  .meta div { padding: 16px 0; border-bottom: 1px solid var(--color-border); }
  .meta dt { font-size: 13px; margin-bottom: 4px; }
  .meta dd { margin: 0; font-size: 15px; font-weight: 500; }

  .hero { margin-bottom: 104px; aspect-ratio: 16 / 9; }
  .hero-img { width: 100%; height: auto; object-fit: cover; border-radius: var(--p-radius-md); }

  .next {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 40px 0 0;
    border-top: 1px solid var(--color-border);
  }
  .next:hover { color: inherit; }
  .next:hover .next-title { color: var(--color-text-subtle); }
  .next-title { font-size: clamp(26px, 3vw, 36px); font-weight: 600; letter-spacing: -0.03em; transition: color .15s; }

  /* Case body: section title on the left, reading column on the right.
     Sparse auto-placement puts the first block after each heading on the
     heading's row, so titles stay aligned with their section. */
  .prose {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 48px;
    padding-bottom: 104px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
  @media (min-width: 900px) {
    .prose { grid-template-columns: minmax(200px, 1fr) minmax(0, 1.6fr); }
    .prose :global(> *) { grid-column: 2; max-width: 660px; }
    .prose :global(> h2) { grid-column: 1; }
    .prose :global(> figure) { grid-column: 1 / -1; max-width: none; }
  }
  .prose :global(> *) { margin: 0 0 16px; }
  .prose :global(h2) {
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--color-text);
    margin-top: 80px;
  }
  .prose :global(h2 + *) { margin-top: 80px; }
  .prose :global(h2:first-child), .prose :global(h2:first-child + *) { margin-top: 0; }
  @media (max-width: 899px) { .prose :global(h2 + *) { margin-top: 0; } .prose :global(h2) { margin-top: 56px; } }
  .prose :global(strong) { font-weight: 600; color: var(--color-text); }
  .prose :global(ul), .prose :global(ol) { padding-left: 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(li::marker) { color: var(--color-text-subtle); }
  .prose :global(figure) { margin: 56px 0; display: flex; flex-direction: column; gap: 12px; }
  .prose :global(figcaption) { font-size: 13px; color: var(--color-text-subtle); }
  .prose :global(figure .placeholder) { aspect-ratio: 16 / 8; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; }
  .prose :global(th) {
    text-align: left; font-size: 13px; font-weight: 500; color: var(--color-text-subtle);
    padding: 10px 12px 10px 0; border-bottom: 1px solid var(--color-border-strong);
  }
  .prose :global(td) { padding: 12px 12px 12px 0; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .prose :global(td:first-child) { color: var(--color-text); font-weight: 500; }
</style>
