---
// A project: dark panel on the left that stays put (title, text, facts),
// the case on the right on white, read by scrolling.
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Socials from './Socials.astro';
import { site } from '../site';
import { t, prefix, type Lang } from '../i18n';
import { getCases, slugOf } from '../cases';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { lang, entry, next } = Astro.props;
const s = t[lang];
const { Content } = await render(entry);
const d = entry.data;
const base = prefix(lang);
const cases = await getCases(lang);
const current = slugOf(entry.id);
---
<Base lang={lang} title={`${d.title} · ${site.name}`} description={d.summary} screen>
  <div class="project" slot="hero">
    <aside class="panel">
      <div class="back-bar"><a class="back" href={`${base}/work/`}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M14 8a.5.5 0 0 1-.5.5H3.71l3.64 3.65a.5.5 0 0 1-.7.7l-4.5-4.5a.5.5 0 0 1 0-.7l4.5-4.5a.5.5 0 1 1 .7.7L3.71 7.5h9.79A.5.5 0 0 1 14 8Z" fill="currentColor"/></svg> {s.backToWork}</a></div>
      <div class="panel-body" transition:animate="fade">
        <p class="panel-meta">{d.company}{d.year && ` · ${d.year}`}</p>
        <h1 class="t-title">{d.title}</h1>
        <p class="t-lead">{d.lead}</p>
        <dl class="facts">
          {d.meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>

    <div class="main">
      <div class="main-bar">
        <Socials class="main-socials socials--dark" />
        <nav class="switch" aria-label={s.projectsLabel}>
          <a href={`${base}/work/`}>{s.allProjects}</a>
          {cases.map((c) => (
            <a href={`${base}/work/${slugOf(c.id)}/`} aria-current={slugOf(c.id) === current ? 'page' : undefined}>{c.data.tabLabel ?? c.data.company}</a>
          ))}
        </nav>
      </div>

      <div class="main-body" transition:animate="fade">
        {d.cover ? (
          <img class="cover" src={d.cover} alt={d.hero.replace(/^\[|\]$/g, '')} />
        ) : (
          <div class="placeholder cover">{d.hero}</div>
        )}

        <div class="prose">
          <Content />
        </div>

        <a class="next" href={`${base}/work/${slugOf(next.id)}/`}>
          <span class="next-label">{s.nextCase}</span>
          <span class="next-title">{next.data.title} <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .project { display: grid; grid-template-columns: minmax(0, 35.5%) minmax(0, 1fr); min-height: 100svh; background: #fff; }

  /* left: stays in place while the case scrolls */
  .panel { position: sticky; top: 0; height: 100svh; overflow-y: auto; display: flex; flex-direction: column; background: #fff; color: #181C26; scrollbar-width: none; border-right: 1px solid #D6DCF5; }
  .back { display: flex; align-items: center; gap: 8px; min-height: 41px; padding: 0 clamp(20px, 1.25vw, 24px); background: #fff; color: #181C26; font-weight: 300; font-size: clamp(14px, 1.04vw, 20px); letter-spacing: -0.04em; }
  .back-bar { display: flex; background: #EFF2FB; }
  .back { flex: none; }
  .back:hover { color: #5A6481; }
  .panel-body { container-type: inline-size; display: flex; flex-direction: column; gap: clamp(20px, 2.4vw, 44px); padding: clamp(40px, 5.5vw, 96px) clamp(20px, 1.25vw, 24px) 40px; }
  .panel-meta { margin: 0 0 calc(-1 * clamp(8px, 1.4vw, 24px)); font-size: clamp(13px, 3cqi, 16px); color: #5A6481; }
  .panel .t-title { font-size: clamp(30px, 11.5cqi, 79px); }
  .panel .t-lead { font-size: clamp(16px, 5.3cqi, 36px); }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
  .facts div { padding: 12px 0; border-top: 1px solid #D6DCF5; }
  .facts dt { font-size: 12px; color: #5A6481; margin-bottom: 3px; }
  .facts dd { margin: 0; font-size: 14px; font-weight: 500; }

  /* right: bar with socials, then the project switcher */
  .main { min-width: 0; display: flex; flex-direction: column; }
  .main-bar { position: sticky; top: 0; z-index: 3; background: #fff; display: grid; grid-template-columns: minmax(0, 1fr); }
  .main-bar :global(.main-socials) { justify-self: end; min-height: 41px; padding: 0 clamp(12px, 1.25vw, 24px); }
  .switch { display: flex; max-width: 100%; overflow-x: auto; scrollbar-width: none; justify-self: start; background: #fff; }
  .switch::-webkit-scrollbar { display: none; }
  .switch a { flex: none; min-width: clamp(64px, 6.6vw, 126px); text-align: center; padding: 8px clamp(12px, 1.25vw, 24px); color: #181C26; font-weight: 300; font-size: clamp(14px, 1.04vw, 20px); line-height: 1.27; letter-spacing: -0.04em; white-space: nowrap; }
  .switch a:hover { background: #F6F7FC; color: #181C26; }
  .switch a[aria-current="page"] { background: #EFF2FB; color: #181C26; }

  .main-body { display: flex; flex-direction: column; padding: 0 clamp(20px, 3.3vw, 64px) 64px; }
  .cover { display: block; width: 100%; height: calc(100svh - 88px); object-fit: contain; background: #fff; margin: 0 0 clamp(40px, 5vw, 80px); border-radius: 0; }
  .placeholder.cover { height: 60svh; }

  .prose { max-width: 760px; font-size: 18px; line-height: 1.65; color: #3A4152; }
  .prose :global(> *) { margin: 0 0 18px; }
  .prose :global(h2) { margin: clamp(56px, 6vw, 96px) 0 20px; color: #000; font-weight: 600; font-size: clamp(28px, 2.9vw, 48px); line-height: 1.02; letter-spacing: -0.06em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(strong) { font-weight: 600; color: #000; }
  .prose :global(a) { color: #000; text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(blockquote) { margin: 40px 0; padding: 0; color: #000; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.2; font-weight: 600; letter-spacing: -0.04em; }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(figure) { margin: clamp(40px, 5vw, 72px) 0; max-width: none; width: min(100%, calc(100vw * .645 - 2 * clamp(20px, 3.3vw, 64px))); display: flex; flex-direction: column; gap: 12px; }
  .prose :global(figure img) { width: 100%; height: auto; background: #F3F4F8; }
  .prose :global(figure .placeholder) { aspect-ratio: 16 / 9; border-radius: 0; }
  .prose :global(figcaption) { font-size: 14px; color: #5A6481; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; }
  .prose :global(th) { text-align: left; font-size: 13px; font-weight: 500; color: #5A6481; padding: 10px 12px 10px 0; border-bottom: 1px solid #181C26; }
  .prose :global(td) { padding: 12px 12px 12px 0; border-bottom: 1px solid #D6DCF5; vertical-align: top; }

  .next { display: block; margin-top: clamp(64px, 8vw, 120px); padding-top: 28px; border-top: 1px solid #D6DCF5; color: #000; }
  .next:hover { color: #000; }
  .next-label { display: block; margin-bottom: 8px; font-size: 15px; color: #5A6481; }
  .next-title { display: block; font-weight: 600; font-size: clamp(32px, 4.2vw, 72px); line-height: 1; letter-spacing: -0.06em; transition: color .2s; }
  .next:hover .next-title { color: #5A6481; }

  @media (max-width: 860px) {
    .project { grid-template-columns: 1fr; }
    .panel { position: static; height: auto; }
    .main-bar { position: static; }
    .cover { height: auto; max-height: 80svh; }
    .prose :global(figure) { width: 100%; }
  }
</style>
