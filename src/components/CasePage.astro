---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { t, prefix, type Lang } from '../i18n';
import { slugOf } from '../cases';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { lang, entry, next } = Astro.props;
const s = t[lang];
const { Content } = await render(entry);
---
<Base lang={lang} title={`${entry.data.title} · ${site.name}`} description={entry.data.summary}>
  <div class="case">
    <aside class="panel grain">
      <span class="kicker">{entry.data.kicker}</span>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.lead}</p>
      <dl class="meta">
        {entry.data.meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    </aside>

    <div class="body">
      {entry.data.cover ? (
        <img class="hero-img" src={entry.data.cover} alt={entry.data.hero.replace(/^\[|\]$/g, '')} />
      ) : (
        <div class="placeholder hero-img">{entry.data.hero}</div>
      )}

      <article class="prose">
        <Content />
      </article>

      <a class="next" href={`${prefix(lang)}/work/${slugOf(next.id)}/`}>
        <span class="subtle">{s.nextCase}</span>
        <span class="next-title">{next.data.title} <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
</Base>

<style>
  /* Collage version: a tinted, grainy title panel that stays put while the work scrolls. */
  .case { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 8px; }
  @media (min-width: 1000px) {
    .case { grid-template-columns: minmax(320px, 400px) minmax(0, 1fr); gap: 56px; align-items: start; }
    .panel { position: sticky; top: 24px; max-height: calc(100vh - 48px); overflow: auto; }
  }
  .panel {
    background: #E6EAFB;
    border-radius: var(--p-radius-lg);
    padding: clamp(28px, 3vw, 40px);
    display: flex; flex-direction: column; gap: 18px;
  }
  .kicker { font-size: 14px; color: #4A5163; }
  h1 {
    margin: 0;
    font-size: clamp(36px, 4vw, 54px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .lead { margin: 0; font-size: 16px; line-height: 1.6; color: #2F3443; }
  .meta { margin: 8px 0 0; display: flex; flex-direction: column; }
  .meta div { padding: 12px 0; border-top: 1px solid rgba(20, 30, 60, .12); }
  .meta dt { font-size: 12px; color: #4A5163; margin-bottom: 2px; }
  .meta dd { margin: 0; font-size: 14px; font-weight: 500; }

  .hero-img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--p-radius-md); margin-bottom: 72px; }

  .next {
    display: flex; flex-direction: column; gap: 8px;
    padding: 40px 0 0; border-top: 1px solid var(--color-border);
  }
  .next:hover { color: inherit; }
  .next:hover .next-title { color: var(--color-text-subtle); }
  .next-title { font-size: clamp(26px, 3vw, 36px); font-weight: 700; letter-spacing: -0.03em; transition: color .15s; }

  .prose { padding-bottom: 96px; font-size: 17px; line-height: 1.65; color: var(--color-text-muted); max-width: 720px; }
  .prose :global(> *) { margin: 0 0 16px; }
  .prose :global(h2) {
    font-size: clamp(22px, 2vw, 28px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.25;
    color: var(--color-text); margin: 72px 0 16px;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(strong) { font-weight: 600; color: var(--color-text); }
  .prose :global(ul), .prose :global(ol) { padding-left: 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(li::marker) { color: var(--color-text-subtle); }
  .prose :global(figure) { margin: 48px 0; display: flex; flex-direction: column; gap: 12px; }
  .prose :global(figcaption) { font-size: 13px; color: var(--color-text-subtle); }
  .prose :global(figure .placeholder) { aspect-ratio: 16 / 8; }
  .prose :global(figure img) { width: 100%; height: auto; border-radius: var(--p-radius-md); border: 1px solid var(--color-border); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; }
  .prose :global(th) {
    text-align: left; font-size: 13px; font-weight: 500; color: var(--color-text-subtle);
    padding: 10px 12px 10px 0; border-bottom: 1px solid var(--color-border-strong);
  }
  .prose :global(td) { padding: 12px 12px 12px 0; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .prose :global(td:first-child) { color: var(--color-text); font-weight: 500; }
</style>
