---
// One tab = one screen: tab bar and text on the left, a collage on the right.
import Base from '../layouts/Base.astro';
import TabBar from './TabBar.astro';
import Socials from './Socials.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  active: string;
  title?: string;
  /** collage on the right; leave out and fill the "right" slot instead */
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  /** kept for older calls; every screen now uses the same split so nothing jumps between tabs */
  split?: 'even' | 'wide';
  /** tab bar across both halves (work page), with the social icons at its end */
  fullBar?: boolean;
  /** where the split starts: 'half', or 'nav' = as narrow as the tab bar allows (work page) */
  start?: 'half' | 'nav';
}
const { lang, active, title, image, imageAlt = '', imagePosition, split = 'even', fullBar = false, start = 'half' } = Astro.props;
---
<Base lang={lang} title={title} screen>
  <div class:list={["screen", `screen--${split}`, { "screen--fullbar": fullBar }]} slot="hero" data-split data-default={start === 'nav' ? 'nav' : '50'}>
    {fullBar && (
      <div class="screen-topbar">
        <TabBar lang={lang} active={active} />
        <Socials class="screen-socials-bar" />
      </div>
    )}
    <div class="screen-left">
      {!fullBar && (
        <div class="screen-bar">
          <TabBar lang={lang} active={active} />
          <div class="screen-gap" aria-hidden="true"></div>
        </div>
      )}
      <div class="screen-body" transition:animate="fade">
        <slot />
      </div>
    </div>
    <div class="screen-handle" role="separator" aria-orientation="vertical" aria-label="Ajustar el ancho de las dos mitades" aria-valuemin="25" aria-valuemax="75" aria-valuenow="50" tabindex="0" data-split-handle><span></span></div>
    {image ? (
      <div class="screen-media" transition:name="screen-media">
        <img src={image} alt={imageAlt} style={imagePosition ? `object-position: ${imagePosition}` : undefined} fetchpriority="high" />
        <Socials class="screen-socials" />
      </div>
    ) : (
      <div class="screen-right">
        <slot name="right" />
      </div>
    )}
  </div>
</Base>

<script>
  // Drag the line between the two halves to resize them, while you're on that screen.
  // Every screen opens at its own default (half and half); when you change tab the line
  // glides from where it was to the new screen's default instead of jumping. Double-click resets.
  let last: number | null = null; // split of the screen we're leaving (survives tab changes)

  function initSplit() {
    const screen = document.querySelector<HTMLElement>('[data-split]');
    const handle = screen?.querySelector<HTMLElement>('[data-split-handle]');
    if (!screen || !handle) { last = null; return; }
    // the left half never gets narrower than its tab bar
    const tabs = screen.querySelector<HTMLElement>('.screen-left .tabs ul');
    const minLeft = () => {
      const px = tabs ? tabs.scrollWidth : 0;
      screen.style.setProperty('--min-left', `${px}px`);
      return (px / screen.getBoundingClientRect().width) * 100;
    };
    const clamp = (v: number) => Math.min(75, Math.max(minLeft(), v));
    const startAtNav = screen.dataset.default === 'nav';
    let def = startAtNav ? minLeft() : Number(screen.dataset.default) || 50;
    const set = (v: number) => {
      v = clamp(v);
      screen.style.setProperty('--split', `${v}%`);
      handle.setAttribute('aria-valuenow', String(v));
      last = v;
    };
    const glide = (to: number) => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return set(to);
      screen.getBoundingClientRect(); // commit the starting position before animating
      screen.classList.add('is-gliding');
      set(to);
      setTimeout(() => screen.classList.remove('is-gliding'), 1000);
    };

    // start where the previous screen left the line, then glide to this screen's default
    if (last !== null && Math.abs(last - clamp(def)) > 0.5) {
      set(last);
      glide(def);
    } else {
      set(def);
    }
    // once the fonts are in, the tab bar's real width is known: re-measure the 'nav' start
    const settle = () => {
      const now = Number(handle.getAttribute('aria-valuenow')) || def;
      const atStart = Math.abs(now - def) < 0.5;
      if (startAtNav) def = minLeft();
      set(atStart ? def : now);
    };
    addEventListener('resize', settle);
    document.fonts?.ready.then(settle);

    handle.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      handle.setPointerCapture(e.pointerId);
      screen.classList.remove('is-gliding');
      screen.classList.add('is-dragging');
      const box = screen.getBoundingClientRect();
      const move = (ev: PointerEvent) => set(((ev.clientX - box.left) / box.width) * 100);
      const up = () => {
        screen.classList.remove('is-dragging');
        handle.removeEventListener('pointermove', move);
        handle.removeEventListener('pointerup', up);
      };
      handle.addEventListener('pointermove', move);
      handle.addEventListener('pointerup', up);
    });
    handle.addEventListener('dblclick', () => glide(def));
    handle.addEventListener('keydown', (e) => {
      const now = Number(handle.getAttribute('aria-valuenow'));
      if (e.key === 'ArrowLeft') { e.preventDefault(); set(now - 2); }
      if (e.key === 'ArrowRight') { e.preventDefault(); set(now + 2); }
    });
  }
  document.addEventListener('astro:page-load', initSplit);
</script>

<style>
  .screen { --split: 50%; position: relative; display: grid; grid-template-columns: minmax(var(--min-left, 0px), var(--split)) minmax(0, 1fr); min-height: 100svh; background: #fff; color: #000; }
  .screen--fullbar { grid-template-rows: auto 1fr; }
  .screen-topbar { grid-column: 1 / -1; min-width: 0; display: flex; align-items: stretch; justify-content: space-between; background: #111214; }
  .screen-topbar > :global(.tabs) { min-width: 0; }
  .screen-topbar :global(.screen-socials-bar) { padding: 0 clamp(12px, 1.25vw, 24px); }
  .screen-media :global(.screen-socials) { position: absolute; top: clamp(10px, 1vw, 16px); right: clamp(12px, 1.25vw, 24px); z-index: 2; }
  .screen--fullbar .screen-handle { top: 46px; }
  /* --split is a real percentage so the browser can animate it between screens */
  @property --split { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  .screen.is-gliding { transition: --split .8s cubic-bezier(.65, 0, .2, 1); }
  .screen.is-dragging { cursor: col-resize; user-select: none; }
  .screen.is-dragging img { pointer-events: none; }

  /* the draggable line between the halves */
  .screen-handle {
    position: absolute; top: 0; bottom: 0; left: max(var(--split), var(--min-left, 0px)); z-index: 5;
    width: 24px; transform: translateX(-50%); cursor: col-resize; touch-action: none;
    display: flex; align-items: center; justify-content: center;
  }
  .screen-handle::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; transform: translateX(-50%); background: #181C26; opacity: 0; transition: opacity .2s ease; }
  .screen-handle span { position: relative; width: 8px; height: 56px; background: #181C26; border: 2px solid #fff; transition: height .2s ease; }
  .screen-handle:hover::before, .screen-handle:focus-visible::before, .is-dragging .screen-handle::before { opacity: 1; }
  .screen-handle:hover span, .is-dragging .screen-handle span { height: 80px; }
  .screen-handle:focus-visible { outline: none; }
  .screen-handle:focus-visible span { outline: 2px solid #181C26; outline-offset: 2px; }
  .screen-left { display: flex; flex-direction: column; gap: clamp(24px, 2.1vw, 40px); min-width: 0; padding-bottom: 32px; }
  .screen-gap { height: clamp(32px, 2.45vw, 47px); background: #fff; }
  .screen-body { container-type: inline-size; display: flex; flex-direction: column; gap: clamp(28px, 3vw, 58px); padding: 0 var(--screen-pad, clamp(20px, 1.25vw, 24px)); }
  .screen-media { position: relative; min-height: 100%; overflow: hidden; background: #E8E9E6; }
  .screen-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .screen-right { display: flex; flex-direction: column; min-width: 0; }

  @media (max-width: 860px) {
    .screen, .screen--wide { grid-template-columns: 1fr; }
    .screen-handle { display: none; }
    .screen-topbar :global(.screen-socials-bar) { display: none; }
    .screen-media { min-height: 0; aspect-ratio: 4 / 5; }
    .screen-gap { height: 16px; }
  }
</style>
