---
// Work: intro on the left (with the tab bar, like every other screen); on the right,
// on dark, the social icons and a grid of tall cards. Each card opens its case.
import Screen from './Screen.astro';
import Socials from './Socials.astro';
import { site } from '../site';
import { t, prefix, type Lang } from '../i18n';
import { getCases, slugOf } from '../cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const cases = await getCases(lang);
const base = prefix(lang);
---
<Screen lang={lang} active="work" title={`${s.workTitle} · ${site.name}`} start="nav">
  <h1 class="t-title work-title">{s.workTitle.toLowerCase()}</h1>
  <div>
    {s.workIntro.map((p) => <p class="t-lead work-lead">{p}</p>)}
  </div>

  <div class="work-right" slot="right">
    <div class="work-bar">
      <Socials />
    </div>
    <ul class="cards">
      {cases.map((c, i) => (
        <li>
          <a class="card" href={`${base}/work/${slugOf(c.id)}/`}>
            {c.data.cover && <img src={c.data.cover} alt="" style={c.data.coverPosition ? `object-position: ${c.data.coverPosition}` : undefined} loading={i < 6 ? 'eager' : 'lazy'} />}
            <span class="card-label">{c.data.cardTitle ?? c.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Screen>

<style>
  /* the text column here is narrow on purpose: keep the same type size as the other screens
     (what the column-relative sizes give at half the screen) instead of shrinking with it */
  .work-title { font-size: clamp(28px, calc(4.1vw - 3.9px), 79px); }
  .work-lead { font-size: clamp(16px, calc(1.875vw - 1.8px), 36px); }
  .work-right { display: flex; flex-direction: column; min-height: 100svh; background: #181C26; border-left: 1px solid #fff; }
  .work-bar { display: flex; align-items: center; justify-content: flex-end; min-height: 46px; padding: 0 clamp(12px, 1.25vw, 24px); }

  /* three tall cards per row, all the same size */
  .cards { list-style: none; margin: 0; padding: 0 12px 12px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; align-content: start; }
  .card { position: relative; display: block; aspect-ratio: 370 / 462; overflow: hidden; background: #fff; }
  .card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2, .7, .2, 1); }
  .card:hover img { transform: scale(1.04); }
  .card-label {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 14px 12px;
    color: #fff; font-weight: 300; font-size: clamp(14px, 1.04vw, 20px); line-height: 1.2; letter-spacing: -0.04em;
    background: linear-gradient(to top, rgba(0, 0, 0, .72), transparent); opacity: 0; transition: opacity .25s ease;
  }
  .card:hover .card-label, .card:focus-visible .card-label { opacity: 1; }
  .card:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }

  @media (hover: none) { .card-label { opacity: 1; } }
  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .work-right { min-height: 0; border-left: 0; } .work-bar { display: none; } }
</style>
