---
// The site's only navigation: a white strip of tabs, the current one on a soft blue.
import { t, prefix, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  active: string;
  /** stretch across the page (case pages) instead of sitting in the left column */
  full?: boolean;
}
const { lang, active, full = false } = Astro.props;
const s = t[lang];
const base = `${prefix(lang)}/`;
---
<nav class:list={["tabs", { "tabs--full": full }]} aria-label={s.tabsLabel}>
  <ul>
    {s.tabs.map((tab) => (
      <li>
        <a href={`${base}${tab.path}`} aria-current={tab.key === active ? 'page' : undefined}>{tab.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabs { display: flex; align-items: stretch; background: #fff; min-height: 41px; }
  .tabs ul { display: flex; list-style: none; margin: 0; padding: 0; overflow-x: auto; scrollbar-width: none; }
  .tabs ul::-webkit-scrollbar { display: none; }
  .tabs li { display: flex; flex: none; }
  .tabs ul a {
    display: flex; align-items: center; justify-content: center;
    min-width: clamp(64px, 6.6vw, 126px); padding: 8px clamp(10px, 1.25vw, 24px);
    color: #181C26; font-family: 'Inter', sans-serif; font-weight: 300;
    font-size: clamp(14px, 1.04vw, 20px); line-height: 1.27; letter-spacing: var(--track-s); white-space: nowrap;
    transition: background-color .2s ease, color .2s ease;
  }
  .tabs ul a:hover { background: #F6F7FC; color: #181C26; }
  .tabs ul a[aria-current="page"] { background: #EFF2FB; color: #181C26; }
  .tabs ul a:focus-visible { outline: 2px solid #181C26; outline-offset: -4px; border-radius: 0; }

  @media (max-width: 560px) {
    .tabs ul a { min-width: 0; padding: 8px; font-size: 13px; }
    }
</style>
